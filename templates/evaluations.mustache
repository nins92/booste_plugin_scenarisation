{{!
    @template local_booste/evaluations.mustache


    Example context (json):
    {
        elements:     [ { 
            id: 1, 
            booste: 47, 
            evaluation_type: 5,
            description: "test" 
        } ]
    }
}}
<div class="local-booste-evaluations">
    <table id="local-booste-evaluations" class="flexible table table-striped table-hover generaltable generalbox">
        {{#elements}}
        <tr>
            <td class="local-booste-tab-content">
                <ul>
                    <li>Type d'évaluation : {{evaluation_type_name}} </li>
                    <li>Description : {{description}}</li>
                </ul>
            </td>
            <td class="local-booste-tab-button">
                {{#canedit}}
                <a role="button" class="optionaction" id="id_evaluation" name="evaluation" data-action="editboostepopup" data-formname="evaluation" data-id="{{booste}}" data-editid="{{id}}" data-booste="{{booste}}">
                    {{#pix}} t/edit, core, {{#str}} edit_evaluation, local_booste{{/str}} {{/pix}}
                </a>
                {{/canedit}}
            </td>
            <td class="local-booste-tab-button">
                {{#canedit}}
                <a role="button" class="optionaction" id="id_evaluation" name="evaluation" data-action="delete" data-id="{{id}}" data-booste="{{booste}}">
                    {{#pix}} t/delete, core, {{#str}} delete_evaluation, local_booste{{/str}} {{/pix}}
                </a>
                {{/canedit}}
            </td>
        </tr>
        {{/elements}}
    </table>
</div>
{{#js}}
    require(['local_booste/delete_data'], function(Evaluation) {
        Evaluation.init("evaluation");
    });
    require(['local_booste/popup_form'], function(Evaluation) {
        Evaluation.init("evaluation");
    });
{{/js}}
