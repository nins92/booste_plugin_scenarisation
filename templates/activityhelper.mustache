{{!
    @template local_booste/activityhelper.mustache


    Example context (json):
    {
       activity_id: 1,
       activity_name: "Database",
       helper: "https://link.blabla",
       fields: [
            field_id: 1
            field_name: "challenge",
            tags: [
                tag_id: 1
                field: 5
                tag_name: "challenge1"
            ]
       ]
    
    }
}}
<div class="local-booste-activityhelper">
    <h3>{{activity_name}}</h3>
    <table class="flexible table table-striped table-hover generaltable generalbox">
        {{#helper}}
            <tr>
                <td>{{helper_label}} </td>
                <td><a target="_blank" href="{{helper}}">{{activity_name}}</td>
            </tr>
        {{/helper}}
        {{^helper}}
            <tr>
                <td>{{helper_label}} </td>
                <td>{{#str}} no_link, local_booste{{/str}}</td>
            </tr>
        {{/helper}}
        {{#fields}}
            <tr>
                <td>{{field_name}}</td> 
                <td>
                    {{#tags}} 
                       <span class="badge badge-info mb-3 mr-1"> {{tag_name}} </span>
                    {{/tags}}
                </td>
            </tr>
        {{/fields}}

    </table>
</div>

{{#js}}

{{/js}}