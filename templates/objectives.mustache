{{!
    @template local_booste/objectives.mustache


    Example context (json):
    {
        canedit: true,
        elements: [ { 
            id: 1, 
            booste: 47, 
            objective_sentence: "test" 
        } ]
    }
}}
<div class="local-booste-objectives">
    <table id="local-booste-objectives" class="flexible table table-striped table-hover generaltable generalbox">
        {{#elements}}
            <tr>
                <td class="local-booste-tab-content">
                    <p id="objective_{{id}}" data-taxonomy="{{taxonomy_name}}">{{objective_sentence}}</p>
                </td>
                <td class="local-booste-tab-button">
                    {{#canedit}}
                    <a role="button" class="optionaction" id="id_objective" name="objective" data-action="editboostepopup" data-formname="objective" data-id="{{booste}}" data-editid="{{id}}" data-booste="{{booste}}">
                        {{#pix}} t/edit, core, {{#str}} edit_objective, local_booste{{/str}} {{/pix}}
                    </a>
                    {{/canedit}}
                </td>
                <td class="local-booste-tab-button">
                    {{#canedit}}
                    <a role="button" class="optionaction" id="id_objective" name="objective" data-action="delete" data-id="{{id}}" data-booste="{{booste}}">
                        {{#pix}} t/delete, core, {{#str}} delete_objective, local_booste{{/str}} {{/pix}}
                    </a>
                    {{/canedit}}
                </td>
            </tr>
        {{/elements}}
    </table>
</div>
{{#js}}
    require(['local_booste/delete_data'], function(Objective) {
        Objective.init("objective");
    });
    require(['local_booste/popup_form'], function(Objective) {
        Objective.init("objective");
    });
{{/js}}
