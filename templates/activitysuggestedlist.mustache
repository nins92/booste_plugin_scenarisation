{{!
    @template local_booste/activitysuggestedlist

    Chooser dialog template.

    Example context (json):
    {
        "taxonomy": "synthesis",
        "recommended": {
            "id": "23",
            "activity_type": "ext",
            "index": "2",
            "icon": "<i class></i>",
            "warning_icon": "<i class></i>",
            "match": "24",
            "title": "Test"
        }
    }
}}


<div class="local-booste-recommended">
    <table id="local-booste-recommended-{{taxonomy}}" class="local-booste-contents tbl">
        <thead>
             <th colspan="6">{{taxonomy_i18n}} <span class="badge badge-light">{{recommended.length}}{{#has_more}}+{{hidden_count}}{{/has_more}}</span></th>
        </thead>
        {{#recommended}}
            
            <tr class="local-booste-{{activity_type}}-activity">
                <td class="local-booste-tab-button">{{index}}</td>
                <td class="local-booste-tab-button pr-3">
                    <div class="optionicon mt-2 mb-1 mx-auto icon-no-margin modicon_{{name}} activityiconcontainer {{purpose}}">
                        {{{icon}}}
                    </div>
                </td>
                <td class="local-booste-tab-content">
                    <div id="activity_{{id}}" class="optionname clamp-2">{{title}}</div>
                </td>
                <td class="local-booste-tab-button">
                    <div>{{{warning_icon}}} </div>
                </td>
                <td class="local-booste-tab-button">
                    <span class="local-booste-match" title="{{#str}} match, local_booste {{/str}}">{{match}}%</span>
                </td>
                <td class="local-booste-tab-button">
                     <a role="button" class="optionaction" id="id_activity_helper" name="activity_helper" data-action="activity_helper" data-activitytype="{{activity_type}}" data-id="{{id}}">
                        {{#pix}} docs, core, {{#str}} informationformodule, core_course, {{title}} {{/str}} {{/pix}}
                     </a>
                </td>
            </tr>
        {{/recommended}}
    </table>
    <br>
    <br>
</div>

{{#js}}
    require(['local_booste/helper'], function(Activity) {
        Activity.getActivityHelp();
    });
{{/js}}
